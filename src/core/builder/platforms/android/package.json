{
    "name": "android",
    "version": "1.0.0",
    "author": "Cocos",
    "description": "Android platform plugin",
    "license": "ISC",
    "type": "commonjs",
    "contributes": {
        "builder": {
            "register": true,
            "platform": "android",
            "config": "./src/config",
            "hooks": "./src/hooks"
        },
        "pinkBuildPlatforms": [
            {
                "platform": "android",
                "config": "./src/pink-config.js",
                "hooks": "./src/hooks.js"
            }
        ],
        "pinkBuildHooks": [
            {
                "platforms": [
                    "android"
                ]
            }
        ]
    },
    "scripts": {
        "build-view": "node scripts/build-view.js",
        "watch-view": "node scripts/build-view.js --watch"
    },
    "publisher": "pink-cli",
    "engines": {
        "vscode": "*"
    },
    "main": "./dist/view/build-config-host.js"
}
