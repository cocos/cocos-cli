{
    "name": "huawei-agc",
    "version": "1.0.0",
    "author": "Cocos",
    "description": "Huawei AppGallery Connect platform plugin",
    "license": "ISC",
    "type": "commonjs",
    "contributes": {
        "builder": {
            "register": true,
            "platform": "huawei-agc",
            "config": "./src/config",
            "hooks": "./src/hooks"
        },
        "pinkBuildPlatforms": [
            {
                "platform": "huawei-agc",
                "config": "./src/pink-config.js",
                "hooks": "./src/hooks.js"
            }
        ]
    },
    "scripts": {
        "build-view": "node scripts/build-view.js",
        "watch-view": "node scripts/build-view.js --watch"
    },
    "publisher": "pink-cli",
    "engines": {
        "vscode": "*"
    }
}
