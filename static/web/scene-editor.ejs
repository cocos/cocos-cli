<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <!-- 页面挂在 /scene-editor/ 子路径下，但引擎/脚本资源都在根路径。
         用 base 把相对解析（含 SystemJS import-map 的相对目标）锚定到根，避免被解析成 /scene-editor/... 而 404。 -->
    <base href="/">
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1,viewport-fit=cover"/>
    <meta name="mobile-web-app-capable" content="yes"/>
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="format-detection" content="telephone=no">
    <meta name="renderer" content="webkit"/>
    <meta name="force-rendering" content="webkit"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/>
    <meta name="msapplication-tap-highlight" content="no">
    <meta name="full-screen" content="yes"/>
    <meta name="x5-fullscreen" content="true"/>
    <meta name="360-fullscreen" content="true"/>
    <meta name="screen-orientation" content=""/>
    <meta name="x5-orientation" content="">
    <meta name="x5-page-mode" content="app">
    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #333;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        #GameCanvas {
            width: 100%;
            height: 100%;
        }

        /* ── Test Panel ── */
        #testPanel {
            position: fixed;
            top: 0;
            right: 0;
            width: 280px;
            height: 100%;
            background: rgba(30, 30, 30, 0.92);
            color: #ddd;
            font-size: 12px;
            overflow-y: auto;
            z-index: 9999;
            box-shadow: -2px 0 8px rgba(0,0,0,0.5);
            transition: transform 0.2s;
        }
        #testPanel.collapsed {
            transform: translateX(280px);
        }
        #panelToggle {
            position: fixed;
            top: 8px;
            right: 8px;
            z-index: 10000;
            background: #444;
            color: #ddd;
            border: 1px solid #666;
            border-radius: 4px;
            padding: 4px 10px;
            cursor: pointer;
            font-size: 12px;
        }
        #panelToggle:hover { background: #555; }

        .panel-section {
            border-bottom: 1px solid #444;
            padding: 8px 12px;
        }
        .panel-section h3 {
            margin: 0 0 6px 0;
            font-size: 13px;
            color: #8cf;
            cursor: pointer;
            user-select: none;
        }
        .panel-section h3::before {
            content: '▾ ';
            font-size: 10px;
        }
        .panel-section.folded h3::before {
            content: '▸ ';
        }
        .panel-section.folded .section-body {
            display: none;
        }
        .section-body {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        .row {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }
        .row label {
            min-width: 60px;
            color: #aaa;
        }
        .btn {
            background: #3a3a3a;
            color: #ddd;
            border: 1px solid #555;
            border-radius: 3px;
            padding: 3px 8px;
            cursor: pointer;
            font-size: 11px;
        }
        .btn:hover { background: #4a4a4a; border-color: #777; }
        .btn:active { background: #555; }
        .btn.active {
            background: #2a6da8;
            border-color: #4a9de8;
            color: #fff;
        }
        .btn-primary {
            background: #2a6da8;
            border-color: #4a9de8;
            color: #fff;
        }
        .btn-primary:hover { background: #3580bf; }
        select, input[type="range"] {
            background: #2a2a2a;
            color: #ddd;
            border: 1px solid #555;
            border-radius: 3px;
            padding: 2px 4px;
            font-size: 11px;
        }
        select { flex: 1; min-width: 0; }
        input[type="range"] { flex: 1; }
        input[type="checkbox"] { accent-color: #4a9de8; }
        .info-text {
            color: #888;
            font-size: 11px;
            word-break: break-all;
        }
        .status-ok { color: #6c6; }
        .status-warn { color: #cc6; }
        .status-err { color: #c66; }
        #log {
            max-height: 100px;
            overflow-y: auto;
            font-family: monospace;
            font-size: 10px;
            background: #1a1a1a;
            padding: 4px;
            border-radius: 3px;
        }
        #log div { padding: 1px 0; }
    </style>
</head>
<body>
    <div id="GameDiv" class="wrapper">
        <div id="Cocos3dGameContainer">
            <canvas id="GameCanvas" tabindex="-1" style="background-color: '';"></canvas>
        </div>
    </div>

    <button id="panelToggle">Panel</button>

    <div id="testPanel">
        <!-- Scene -->
        <div class="panel-section" id="sec-scene">
            <h3 id="sec-scene-h">Scene</h3>
            <div class="section-body">
                <div class="row">
                    <label>UUID/URL</label>
                    <input type="text" id="sceneInput" placeholder="db://assets/... or UUID" style="flex:1;background:#2a2a2a;color:#ddd;border:1px solid #555;border-radius:3px;padding:2px 4px;font-size:11px;">
                </div>
                <div class="row">
                    <button class="btn btn-primary" id="btnLoad">Load Scene</button>
                    <span id="sceneStatus" class="info-text">Not loaded</span>
                </div>
                <div class="row">
                    <button class="btn btn-primary" id="btnPreview">▶ Preview (Browser)</button>
                    <span class="info-text">opens /</span>
                </div>
                <div class="row">
                    <label>Script</label>
                    <input type="text" id="scriptNameInput" placeholder="TestComponent" value="TestComponent" style="flex:1;background:#2a2a2a;color:#ddd;border:1px solid #555;border-radius:3px;padding:2px 4px;font-size:11px;">
                </div>
                <div class="row">
                    <button class="btn" id="btnCreateScript">Create Script</button>
                    <button class="btn" id="btnDeleteScript">Delete Script</button>
                    <button class="btn" id="btnCheckMenus">Check Menus</button>
                    <span id="scriptStatus" class="info-text">-</span>
                </div>
            </div>
        </div>

        <!-- Debug View：调用 Engine.changeDebugOption 控制渲染调试视图（单一通道 / 组合光照项 / 纯光照 / CSM 染色） -->
        <div class="panel-section" id="sec-debugview">
            <h3 id="sec-debugview-h">Debug View</h3>
            <div class="section-body">
                <div class="row">
                    <label>Lighting w/ albedo</label>
                    <input type="checkbox" id="dbgLWA" checked>
                </div>
                <div class="row">
                    <label>CSM coloration</label>
                    <input type="checkbox" id="dbgCSM">
                </div>
                <div class="row">
                    <button class="btn btn-primary" id="btnResetDebugView">Reset (Shaded)</button>
                </div>
                <!-- Single: 单选(radio)，同一时刻只看一个通道，按类别分组 -->
                <div class="row" style="align-items:flex-start;">
                    <label>Single</label>
                    <div id="dbgSingleList" style="flex:1;display:flex;flex-direction:column;gap:1px;max-height:220px;overflow:auto;"></div>
                </div>
                <!-- Composite: 复选(checkbox)，可多选叠加光照项，按类别分组 -->
                <div class="row">
                    <label>Composite</label>
                    <button class="btn" id="btnCompAllOn">All ON</button>
                    <button class="btn" id="btnCompAllOff">All OFF</button>
                </div>
                <div class="row" style="align-items:flex-start;">
                    <label>Items</label>
                    <div id="dbgCompositeList" style="flex:1;display:flex;flex-direction:column;gap:1px;max-height:220px;overflow:auto;"></div>
                </div>
            </div>
        </div>
        <!-- Debug View END -->

        <!-- Camera -->
        <div class="panel-section" id="sec-camera">
            <h3 id="sec-camera-h">Camera</h3>
            <div class="section-body">
                <div class="row">
                    <label>Zoom</label>
                    <button class="btn" id="btnZoomReset">Zoom Reset</button>
                </div>
                <div class="row">
                    <label>Grid</label>
                    <input type="checkbox" id="chkGrid" checked>
                    <span class="info-text">Show grid</span>
                </div>
                <div class="row">
                    <label>Projection</label>
                    <button class="btn" id="btnToggleProjection">Toggle</button>
                    <span id="projLabel" class="info-text">perspective</span>
                </div>
                <div class="row">
                    <label>FOV</label>
                    <input type="range" id="fovSlider" min="10" max="120" value="45">
                    <span id="fovVal" class="info-text">45</span>
                </div>
                <div class="row">
                    <label>Mode</label>
                    <button class="btn" id="btn2D">2D</button>
                    <button class="btn active" id="btn3D">3D</button>
                </div>
                <div class="row">
                    <button class="btn" id="btnResetCamera">Reset Camera</button>
                </div>
                <div class="row">
                    <label>Align</label>
                    <button class="btn" id="btnAlignViewToNode">View→Node</button>
                    <button class="btn" id="btnAlignNodeToView">Node→View</button>
                </div>
                <div class="row">
                    <label>View Axis</label>
                    <button class="btn" id="btnViewFront" title="Front (+Z → -Z)">Front</button>
                    <button class="btn" id="btnViewBack" title="Back (-Z → +Z)">Back</button>
                </div>
                <div class="row">
                    <label></label>
                    <button class="btn" id="btnViewLeft" title="Left (+X → -X)">Left</button>
                    <button class="btn" id="btnViewRight" title="Right (-X → +X)">Right</button>
                </div>
                <div class="row">
                    <label></label>
                    <button class="btn" id="btnViewTop" title="Top (+Y → -Y)">Top</button>
                    <button class="btn" id="btnViewBottom" title="Bottom (-Y → +Y)">Bottom</button>
                </div>
                <div class="row">
                    <label>Cam Pos</label>
                    <span id="camPos" class="info-text">-</span>
                </div>
                <div class="row">
                    <label>Focus</label>
                    <button class="btn" id="btnFocusSelected">Focus Selected</button>
                </div>
            </div>
        </div>

        <!-- Gizmo -->
        <div class="panel-section" id="sec-gizmo">
            <h3 id="sec-gizmo-h">Gizmo</h3>
            <div class="section-body">
                <div class="row">
                    <label>Tool</label>
                    <button class="btn active" id="tool-position">Pos</button>
                    <button class="btn" id="tool-rotation">Rot</button>
                    <button class="btn" id="tool-scale">Scl</button>
                    <button class="btn" id="tool-rect">Rect</button>
                    <button class="btn" id="tool-view">View</button>
                </div>
                <div class="row">
                    <label>Coord</label>
                    <button class="btn active" id="coord-local">Local</button>
                    <button class="btn" id="coord-global">Global</button>
                </div>
                <div class="row">
                    <label>Pivot</label>
                    <button class="btn active" id="pivot-pivot">Pivot</button>
                    <button class="btn" id="pivot-center">Center</button>
                </div>
                <div class="row">
                    <label>Lock Tool</label>
                    <input type="checkbox" id="chkLock">
                </div>
                <div class="row">
                    <label>Icons</label>
                    <input type="checkbox" id="chkIcons" checked>
                    <span class="info-text">Show gizmo icons</span>
                </div>
                <div class="row">
                    <label>Current</label>
                    <span id="toolName" class="info-text">position</span>
                </div>
            </div>
        </div>

        <!-- Selection -->
        <div class="panel-section" id="sec-selection">
            <h3 id="sec-selection-h">Selection</h3>
            <div class="section-body">
                <div class="row">
                    <label>Node</label>
                    <select id="nodeList"><option value="">-- load scene first --</option></select>
                </div>
                <div class="row">
                    <button class="btn" id="btnSelect">Select</button>
                    <button class="btn" id="btnUnselect">Unselect</button>
                    <button class="btn" id="btnClearSel">Clear</button>
                    <button class="btn" id="btnRefreshNodes">Refresh</button>
                </div>
                <div class="row">
                    <label>Selected</label>
                    <span id="selInfo" class="info-text">none</span>
                </div>
                <div class="row">
                    <label>Path</label>
                    <input type="text" id="focusPathInput" placeholder="e.g. Canvas/Node"
                           style="flex:1;background:#2a2a2a;color:#ddd;border:1px solid #555;border-radius:3px;padding:2px 4px;font-size:11px;">
                    <button class="btn" id="btnSelectFocus" title="Select node by path and focus camera">Select + Focus</button>
                </div>
            </div>
        </div>

        <!-- SceneView -->
        <div class="panel-section" id="sec-sceneview">
            <h3 id="sec-sceneview-h">SceneView</h3>
            <div class="section-body">
                <div class="row">
                    <label>Scene Light</label>
                    <input type="checkbox" id="chkLight" checked>
                    <span class="info-text">Use scene lights</span>
                </div>
            </div>
        </div>

        <!-- Rect Test -->
        <div class="panel-section" id="sec-rect-test">
            <h3 id="sec-rect-test-h">Rect Test</h3>
            <div class="section-body">
                <div class="row">
                    <label>Multi-Select</label>
                    <button class="btn" id="btnMultiSelect">Add to Sel</button>
                    <button class="btn" id="btnSelectAll2D">All 2D</button>
                </div>
                <div class="row">
                    <label>Rect Tool</label>
                    <button class="btn" id="btnRectSwitch">Switch to Rect</button>
                </div>
                <div class="row">
                    <label>Selected</label>
                    <span id="rectSelInfo" class="info-text">0 nodes</span>
                </div>
                <div class="row">
                    <label>Bounds</label>
                    <span id="rectBoundsInfo" class="info-text">-</span>
                </div>
            </div>
        </div>

        <!-- Log -->
        <div class="panel-section" id="sec-log">
            <h3 id="sec-log-h">Log</h3>
            <div class="section-body">
                <div id="log"></div>
                <button class="btn" id="btnClearLog">Clear</button>
            </div>
        </div>
    </div>


    <script type="module">
        const { default: initPage } = await import('/static/web/scene-editor-page.js');
        await initPage({ ip: '<%= ip %>', port: '<%= port %>', https: <%= https %> });
    </script>
</body>
</html>
